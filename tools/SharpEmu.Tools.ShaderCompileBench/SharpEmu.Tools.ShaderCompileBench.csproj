<!--
  Offline timing of the Metal v2 shader compile path on a title's recorded prewarm
  lists: GCN to MSL translation, the MSL front end, function lookup and pipeline-state
  creation, per shader. Dev tool only; it reads a copy of the per-title cache directory.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/graphics/SharpEmu.Gpu.Metal/SharpEmu.Gpu.Metal.csproj" />
  </ItemGroup>

</Project>
