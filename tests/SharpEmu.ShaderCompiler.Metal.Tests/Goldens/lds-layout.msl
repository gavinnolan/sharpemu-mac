// Finds the mapped range of a guest address; a miss records the page in the fault bitmap.
static inline device uint* sharpemu_resolve_device_address(device const Gen5AddressRange* ranges, uint range_count, device uint* faults, uint fault_words, ulong address, thread bool& valid)
{
