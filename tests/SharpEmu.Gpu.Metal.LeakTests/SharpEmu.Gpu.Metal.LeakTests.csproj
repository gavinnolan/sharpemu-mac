<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('OSX'))">false</IsTestProject>
    <!-- The leak check compares native bytes in use across thousands of flushes. The JIT's
         tier-up bookkeeping (call-counting stubs, code versions) is malloc growth of its own
         and would drown a per-flush leak, so methods here compile once, fully optimised. This
         is why the check is not in SharpEmu.Gpu.Metal.Tests, whose timing-sensitive tests
         are written against tiered code. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <!-- The scene rig the Metal device tests drive, compiled here as it is there. -->
    <Compile Include="../SharpEmu.Gpu.Metal.Tests/Scenes/SceneRig.cs" Link="Scenes/SceneRig.cs" />
    <Compile Include="../SharpEmu.Gpu.Metal.Tests/Scenes/SceneMemory.cs" Link="Scenes/SceneMemory.cs" />
    <Compile Include="../SharpEmu.Gpu.Metal.Tests/Scenes/ScenePm4.cs" Link="Scenes/ScenePm4.cs" />
    <Compile Include="../SharpEmu.Gpu.Metal.Tests/Scenes/SceneState.cs" Link="Scenes/SceneState.cs" />
    <Compile Include="../SharpEmu.Gpu.Metal.Tests/Scenes/SceneDraws.cs" Link="Scenes/SceneDraws.cs" />
    <Compile Include="../SharpEmu.Gpu.Metal.Tests/Scenes/ScenePrograms.cs" Link="Scenes/ScenePrograms.cs" />
    <Compile Include="../SharpEmu.ShaderCompiler.Metal.Tests/MetalNative.cs" Link="Fixtures/MetalNative.cs" />
    <Compile Include="../SharpEmu.ShaderCompiler.Metal.Tests/MetalNative.DeviceMemory.cs" Link="Fixtures/MetalNative.DeviceMemory.cs" />
    <ProjectReference Include="../../src/graphics/SharpEmu.Gpu.Metal/SharpEmu.Gpu.Metal.csproj" />
    <ProjectReference Include="../../src/platforms/macos/SharpEmu.Host.MacOS/SharpEmu.Host.MacOS.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
</Project>
