<Project Sdk="Microsoft.NET.Sdk">
  <!-- macOS host services (BSD syscalls, Mach VM, pthread/TLS, dispatch).
       Referenced only by osx-* builds; see the conditional ProjectReference in
       SharpEmu.CLI.csproj. Deliberately does not reference SDL: macOS audio is
       a native CoreAudio output. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only failure-injection hooks on the view backend. -->
    <InternalsVisibleTo Include="SharpEmu.Libs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SharpEmu.HLE\SharpEmu.HLE.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared by source, not by a Host.Posix assembly: only the parts that
         carry no OS-specific declaration, constant or ABI detail. -->
    <Compile Include="..\..\shared\Posix\PosixStubEmitter.cs"
             Link="Threading\Shared\PosixStubEmitter.cs" />
  </ItemGroup>
</Project>
