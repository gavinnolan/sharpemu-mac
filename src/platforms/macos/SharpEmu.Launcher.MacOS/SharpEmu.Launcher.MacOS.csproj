<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><GenerateDocumentationFile>false</GenerateDocumentationFile><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../../SharpEmu.Application/SharpEmu.Application.csproj" /><ProjectReference Include="../../../SharpEmu.Logging/SharpEmu.Logging.csproj" /></ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="$(IntermediateOutputPath)SharpEmu.ChildHost" Link="SharpEmu.ChildHost" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildNativeChildHost" BeforeTargets="GetCopyToOutputDirectoryItems" Condition="$([MSBuild]::IsOSPlatform('OSX'))" Inputs="$(MSBuildProjectDirectory)/Native/child-host.c;$(MSBuildProjectDirectory)/Native/build-child-host.sh" Outputs="$(IntermediateOutputPath)SharpEmu.ChildHost">
    <Exec Command="/bin/bash &quot;$(MSBuildProjectDirectory)/Native/build-child-host.sh&quot; &quot;$(MSBuildProjectDirectory)/Native/child-host.c&quot; &quot;$(IntermediateOutputPath)SharpEmu.ChildHost&quot;" />
  </Target>
</Project>
