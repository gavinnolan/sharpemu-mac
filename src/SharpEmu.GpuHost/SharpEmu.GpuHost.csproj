<!--
  Process B of the two-process split: the native arm64 GPU host. SharpEmu.CLI (process A)
  runs guest code under Rosetta and starts this executable through GpuProcessHost when
  SHARPEMU_GPU_PROCESS=1; the two talk through SharpEmu.GpuRemote's shared-memory region.
  Today it only attaches, handshakes and answers pings; the Metal backend
  (SharpEmu.Gpu.Metal) moves in here next.

  osx-arm64 always (Directory.Build.props pins the RID): running natively is the reason it
  exists. Self-contained like SharpEmu.CLI, so it needs no installed arm64 runtime - the
  emulator's own runtime is x86-64 and cannot host it - and lands in
  artifacts/bin/<Configuration>/net10.0/osx-arm64/, next to the CLI's osx-x64 folder, where
  GpuProcessHost.FindExecutable looks for it.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpEmu.GpuRemote\SharpEmu.GpuRemote.csproj" />
  </ItemGroup>

</Project>
