<!--
  The cross-process transport of the two-process split: process A (SharpEmu.CLI, x86-64 under
  Rosetta) and process B (SharpEmu.GpuHost, native arm64, the future home of the Metal backend)
  share one POSIX shared-memory region holding byte rings, doorbells and synchronous call slots.

  A leaf assembly with no SharpEmu references, built AnyCPU, so both architectures' processes
  can load it, and so can any layer that later has to cross the line - the fault handler in
  SharpEmu.Cpu.DirectExecution.MacOS.X64 included. Not wired into the emulator yet; see
  GpuProcessHost (A) and GpuProcessClient (B).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpEmu.GpuRemote.Tests" />
  </ItemGroup>

</Project>
