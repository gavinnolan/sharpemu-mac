<!--
  The cross-process transport of the two-process split: process A (SharpEmu.CLI, x86-64 under
  Rosetta) and process B (SharpEmu.GpuHost, native arm64, the Metal backend's host) share one
  POSIX shared-memory region holding byte rings, doorbells, synchronous call slots both ways and
  an application block.

  A leaf assembly with no SharpEmu references, built AnyCPU, so both architectures' processes
  can load it, and so can any layer that has to cross the line - the fault handler in
  SharpEmu.Cpu.DirectExecution.MacOS.X64 included. The split's wiring on top of it is
  SharpEmu.GpuSplit; see GpuProcessHost (A) and GpuProcessClient (B) for the processes.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpEmu.GpuRemote.Tests" />
  </ItemGroup>

</Project>
