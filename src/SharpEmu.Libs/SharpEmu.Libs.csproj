<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\SharpEmu.LibAtrac9\SharpEmu.LibAtrac9.csproj" />
    <ProjectReference Include="..\SharpEmu.HLE\SharpEmu.HLE.csproj" />
    <ProjectReference Include="..\SharpEmu.Logging\SharpEmu.Logging.csproj" />
    <ProjectReference Include="..\SharpEmu.ShaderCompiler\SharpEmu.ShaderCompiler.csproj" />
    <!-- The MSL emitter moved out with the Metal backend; only
         SharpEmu.Gpu.Metal references it now. SharpEmu.ShaderCompiler.Vulkan
         follows the same way with SharpEmu.Gpu.Vulkan. -->
    <ProjectReference Include="..\SharpEmu.ShaderCompiler.Vulkan\SharpEmu.ShaderCompiler.Vulkan.csproj" />
    <!-- SysAbi export generator + analyzers (compile-time registry, NID validation). -->
    <ProjectReference Include="..\SharpEmu.SourceGenerators\SharpEmu.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PS5 symbol catalog: lets the analyzer flag export names it doesn't know. -->
    <AdditionalFiles Include="..\..\scripts\ps5_names.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpEmu.Libs.Tests" />
    <!-- The runtime reads internal load-progress diagnostics. -->
    <InternalsVisibleTo Include="SharpEmu.Core" />
  </ItemGroup>

  <!-- Transitional friend assemblies for the graphics/platform package split.
       The backends were carved out of this project, so they still reach a long
       tail of its internals: IGuestGpuBackend and GuestGpu, the shared GPU
       engine (IRenderHost, RenderExecutor, ShaderPipelineCache, GpuFatal,
       GuestDataPool), the internal VideoOut diagnostics (RenderPhaseProfile,
       WindowPollProfile, SubmissionFlowProfile, BufferUploadProfile,
       PerfOverlay) and the internal HLE-export state they present for
       (AgcExports, VideoOutExports, PadExports).

       The alternative - making several hundred shared-engine members public -
       would freeze the seam before it is settled, so the friend list is the
       deliberate intermediate step. It is explicit, it names only the four
       packages that were extracted from here, and it shrinks as the backend
       surface is narrowed to the public contracts in Gpu/Abstractions. No
       other assembly gets added to it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SharpEmu.Gpu.Metal" />
    <InternalsVisibleTo Include="SharpEmu.Gpu.Vulkan" />
    <InternalsVisibleTo Include="SharpEmu.Platform.MacOS" />
    <InternalsVisibleTo Include="SharpEmu.Adapters.Sdl" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" />
    <PackageReference Include="NLayer" />
    <PackageReference Include="ppy.SDL3-CS" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <!-- Native asset packages are selected by the *target* RID, not by the OS of
       the machine doing the build. SkiaSharp.NativeAssets.Linux was referenced
       unconditionally, which means a macOS or Windows publish restored a
       package whose only payload is runtimes/linux-*/native/libSkiaSharp.so.
       RID-specific publish already filtered those files out of the output, but
       the reference still pulled the package into restore and would copy the
       .so into any RID-less build output on a Linux host. Scope it instead:
       Windows natives ship inside the SkiaSharp package itself and the macOS
       natives arrive transitively through Avalonia.Skia
       (SkiaSharp.NativeAssets.macOS), so Linux is the only platform that needs
       an explicit reference. The '$(RuntimeIdentifier)' == '' arm covers
       RID-less builds and test runs, which need the host's own natives. -->
  <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
