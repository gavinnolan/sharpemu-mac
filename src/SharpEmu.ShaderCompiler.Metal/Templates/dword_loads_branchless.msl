// A raw dword load: the address truncates to the dword it lands in, which is what the
// hardware does for S_BUFFER_LOAD_DWORD and BUFFER_LOAD_DWORD and what the SPIR-V
// backend emits. Out of range reads zero. The load is always issued, and a select discards
// it for an index past the end: an index past the end reads the binding's last dword (its
// first when it is empty, which the host still maps: the null buffer is 256 bytes, any other
// binding a page-granular window). A branch around the load would split a shader into one
// block per load, which the compiler cannot issue together.
static inline uint sharpemu_load_dword({{space}} uint* b, uint bytes, uint addr)
{
    uint index = addr >> 2;
    uint words = bytes >> 2;
    uint last = max(words, 1u) - 1u;
    uint value = b[index > last ? last : index];
    return index < words ? value : 0u;
}

// Up to four consecutive raw dwords of an S_BUFFER_LOAD/BUFFER_LOAD_DWORDXn, each what
// sharpemu_load_dword reads at addr + 4 * i, wrapping with the address as it does.
template <int N>
static inline uint4 sharpemu_load_dwords({{space}} uint* b, uint bytes, uint addr)
{
    uint4 result = uint4(0u);
    uint words = bytes >> 2;
    uint last = max(words, 1u) - 1u;
    for (int i = 0; i < N; i++)
    {
        uint index = ((addr >> 2) + (uint)i) & 0x3FFFFFFFu;
        uint value = b[index > last ? last : index];
        result[i] = index < words ? value : 0u;
    }
    return result;
}
