struct Gen5AddressRange
{
    ulong first_page;
    ulong page_count;
    device uint* base;
};

// The range this invocation resolved last. Guest accesses cluster: a loop-invariant
// base read every trip, a stream walking one buffer, a read-modify-write of the word it
// just read. A hit skips the binary search; the ranges cannot change while a dispatch
// runs, and the cache lives only as long as the invocation, so it is never stale. A
// zero page_count matches nothing, which is the empty cache.
struct Gen5RangeCache
{
    ulong first_page;
    ulong page_count;
    device uint* base;
};

// Finds the mapped range of a guest address; a miss records the page in the fault bitmap.
static inline device uint* sharpemu_resolve_device_address(device const Gen5AddressRange* ranges, uint range_count, device uint* faults, uint fault_words, thread Gen5RangeCache& cache, ulong address, thread bool& valid)
{
    ulong masked = address & {{address_mask}};
    ulong page = masked >> {{page_bits}}u;
    if (page - cache.first_page < cache.page_count)
    {
        valid = true;
        ulong byte_offset = ((page - cache.first_page) << {{page_bits}}u) + (masked & {{page_offset_mask}});
        return (device uint*)((device uchar*)cache.base + byte_offset);
    }

    uint low = 0u;
    uint high = range_count;
    for (uint step = 0u; step < {{search_steps}}u; step++)
    {
        uint middle = low + ((high - low) >> 1u);
        bool move_up = low < high && ranges[middle].first_page <= page;
        low = move_up ? middle + 1u : low;
        high = move_up ? high : middle;
    }
    valid = false;
    if (low != 0u)
    {
        Gen5AddressRange range = ranges[low - 1u];
        if (page - range.first_page < range.page_count)
        {
            valid = true;
            cache.first_page = range.first_page;
            cache.page_count = range.page_count;
            cache.base = range.base;
            ulong byte_offset = ((page - range.first_page) << {{page_bits}}u) + (masked & {{page_offset_mask}});
            return (device uint*)((device uchar*)range.base + byte_offset);
        }
    }
    uint page_index = (uint)page;
    uint word = page_index >> 5u;
    if (word < fault_words)
    {
        atomic_fetch_or_explicit((device atomic_uint*)(faults + word), 1u << (page_index & 31u), memory_order_relaxed);
    }
    return nullptr;
}

static inline uint sharpemu_load_device_dword(device const Gen5AddressRange* ranges, uint range_count, device uint* faults, uint fault_words, thread Gen5RangeCache& cache, ulong address)
{
    bool valid = false;
    device uint* word = sharpemu_resolve_device_address(ranges, range_count, faults, fault_words, cache, address, valid);
    return valid ? *word : 0u;
}

// Resolves the first dword of a contiguous multi-dword read once for the whole span.
// A span that stays inside one 16 KB page is contiguous host memory, so its dwords
// index off the one pointer; one that crosses a page reports invalid and the caller
// reads it dword by dword, which is what every dword would have cost before.
static inline device uint* sharpemu_resolve_device_span(device const Gen5AddressRange* ranges, uint range_count, device uint* faults, uint fault_words, thread Gen5RangeCache& cache, ulong address, uint bytes, thread bool& valid)
{
    device uint* first = sharpemu_resolve_device_address(ranges, range_count, faults, fault_words, cache, address, valid);
    valid = valid && (address & 0x3FFFul) + bytes <= 0x4000ul;
    return first;
}

// An unaligned value assembled from the two aligned dwords it spans.
static inline uint sharpemu_load_device_unaligned(device const Gen5AddressRange* ranges, uint range_count, device uint* faults, uint fault_words, thread Gen5RangeCache& cache, ulong address, uint count)
{
    uint alignment = (uint)(address & 3ul);
    ulong aligned = address & ~3ul;
    uint shift = alignment * 8u;
    uint low = sharpemu_load_device_dword(ranges, range_count, faults, fault_words, cache, aligned);
    uint high = (alignment + count > 4u) ? sharpemu_load_device_dword(ranges, range_count, faults, fault_words, cache, aligned + 4ul) : 0u;
    return (low >> shift) | (shift == 0u ? 0u : (high << (32u - shift)));
}

static inline void sharpemu_store_device_dword(device const Gen5AddressRange* ranges, uint range_count, device uint* faults, uint fault_words, thread Gen5RangeCache& cache, ulong address, uint value)
{
    bool valid = false;
    device uint* word = sharpemu_resolve_device_address(ranges, range_count, faults, fault_words, cache, address, valid);
    if (valid)
    {
        *word = value;
    }
}

static inline void sharpemu_store_device_masked_word(device const Gen5AddressRange* ranges, uint range_count, device uint* faults, uint fault_words, thread Gen5RangeCache& cache, ulong address, uint value, uint mask)
{
    if (mask == 0u)
    {
        return;
    }
    bool valid = false;
    device uint* word = sharpemu_resolve_device_address(ranges, range_count, faults, fault_words, cache, address, valid);
    if (!valid)
    {
        return;
    }
    if (mask == 0xFFFFFFFFu)
    {
        *word = value;
        return;
    }
    device atomic_uint* atomic_word = (device atomic_uint*)word;
    uint observed = atomic_load_explicit(atomic_word, memory_order_relaxed);
    while (!atomic_compare_exchange_weak_explicit(atomic_word, &observed, (observed & ~mask) | value, memory_order_relaxed, memory_order_relaxed))
    {
    }
}

// A sub-dword store merges into the dwords it touches.
static inline void sharpemu_store_device_bytes(device const Gen5AddressRange* ranges, uint range_count, device uint* faults, uint fault_words, thread Gen5RangeCache& cache, ulong address, uint value, uint count)
{
    uint element_mask = count == 1u ? 0xFFu : 0xFFFFu;
    uint alignment = (uint)(address & 3ul);
    ulong aligned = address & ~3ul;
    uint shift = alignment * 8u;
    uint carry_shift = 32u - shift;
    bool crosses = alignment + count > 4u;
    uint masked = value & element_mask;
    sharpemu_store_device_masked_word(ranges, range_count, faults, fault_words, cache, aligned, masked << shift, element_mask << shift);
    sharpemu_store_device_masked_word(ranges, range_count, faults, fault_words, cache, aligned + 4ul, crosses ? (masked >> carry_shift) : 0u, crosses ? (element_mask >> carry_shift) : 0u);
}

// BUFFER/GLOBAL/GDS ATOMIC_INC_U32 and ATOMIC_DEC_U32 wrap against DATA (RDNA2 ISA MUBUF/FLAT atomics):
// INC stores (old >= DATA) ? 0 : old + 1, DEC stores (old == 0 || old > DATA) ? DATA : old - 1.
static inline uint sharpemu_atomic_step(device atomic_uint* word, uint limit, bool increment)
{
    uint observed = atomic_load_explicit(word, memory_order_relaxed);
    while (!atomic_compare_exchange_weak_explicit(word, &observed, increment ? (observed >= limit ? 0u : observed + 1u) : ((observed == 0u || observed > limit) ? limit : observed - 1u), memory_order_relaxed, memory_order_relaxed))
    {
    }
    return observed;
}

// The conditional float replace behind DS_MIN/MAX_F32 and the FMIN/FMAX buffer
// atomics: the word becomes "value" while "compare" ranks below it. A failed
// swap re-reads memory, so the ranking is decided against the word that is
// actually there. Returns the value observed.
static inline uint sharpemu_atomic_float_replace(device atomic_uint* word, uint value, uint compare)
{
    uint observed = atomic_load_explicit(word, memory_order_relaxed);
    while (as_type<float>(compare) < as_type<float>(observed) &&
           !atomic_compare_exchange_weak_explicit(word, &observed, value, memory_order_relaxed, memory_order_relaxed))
    {
    }
    return observed;
}

// BUFFER_ATOMIC_FMIN/FMAX: a real float minimum or maximum of the word
// and the operand, which is not the DS conditional replace above.
static inline uint sharpemu_atomic_float_minmax(device atomic_uint* word, uint value, bool maxValue)
{
    uint observed = atomic_load_explicit(word, memory_order_relaxed);
    while ((maxValue ? as_type<float>(value) > as_type<float>(observed)
                     : as_type<float>(value) < as_type<float>(observed)) &&
           !atomic_compare_exchange_weak_explicit(word, &observed, value, memory_order_relaxed, memory_order_relaxed))
    {
    }
    return observed;
}

// Compare-and-swap that retries only spurious failures; returns the value observed.
static inline uint sharpemu_atomic_compare_swap(device atomic_uint* word, uint compare, uint value)
{
    uint expected = compare;
    while (!atomic_compare_exchange_weak_explicit(word, &expected, value, memory_order_relaxed, memory_order_relaxed) && expected == compare)
    {
    }
    return expected;
}
