<Project>
  <!-- Target-RID-scoped platform policy. The condition tests the RID being
       built, never the OS of the build machine: publishing osx-x64 from a
       Linux host has to get the same guard, and building linux-x64 on a Mac
       must not. -->
  <Import Project="$(RepoRoot)build/platforms/macos/macos.targets"
    Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx'))" />
</Project>
